<IfModule mod_rewrite.c>
    Options -MultiViews
    RewriteEngine On

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Social crawlers need metadata in the initial HTML response. Forward the
    # SPA-relative path to the backend; the backend decides which preview applies.
    RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|Slackbot|TelegramBot) [NC]
    RewriteRule ^(.*)$ ../api/social/preview/$1 [L]

    RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_rewrite.c>
    Options -MultiViews
    RewriteEngine On
    RewriteBase /gaydevs/platform/

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Poll routes need server-rendered social metadata for WhatsApp/social crawlers.
    RewriteRule ^polls(?:/.*)?$ polls-preview.php [L]

    RewriteRule ^ index.html [L]
</IfModule>

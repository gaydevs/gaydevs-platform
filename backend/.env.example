APP_NAME=gaydevs
APP_ENV=local
DEVELOPMENT_SEED_ENABLED=true
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_FRONTEND_URL=http://localhost:5173/gaydevs/platform
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_SCHEDULER_DAYS=30
LOG_OPERATIONAL_DAYS=30

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=525600 # 1 year in minutes
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost,127.0.0.1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=
RATE_LIMIT_GLOBAL_OTP_MAX_ATTEMPTS=100
RATE_LIMIT_GLOBAL_OTP_DECAY_SECONDS=3600
RATE_LIMIT_GLOBAL_EMAIL_MAX_ATTEMPTS=150
RATE_LIMIT_GLOBAL_EMAIL_DECAY_SECONDS=3600
RATE_LIMIT_GLOBAL_EMAIL_DAILY_MAX_ATTEMPTS=250
RATE_LIMIT_GLOBAL_EMAIL_DAILY_DECAY_SECONDS=86400

# Bases MaxMind locais opcionais; o backend nunca consulta GeoIP pela rede.
GEOIP_CITY_DATABASE=
GEOIP_ASN_DATABASE=
GEOIP_UPDATE_ENABLED=false
GEOIP_ACCOUNT_ID=
GEOIP_LICENSE_KEY=
GEOIP_DOWNLOAD_BASE_URL=https://download.maxmind.com/geoip/databases
GEOIP_DOWNLOAD_TIMEOUT_SECONDS=120
GEOIP_DOWNLOAD_RETRY_ATTEMPTS=3
GEOIP_DOWNLOAD_RETRY_SLEEP_MILLISECONDS=1000
GEOIP_UPDATE_LOCK_FILE=
GEOIP_DATABASE_DIRECTORY=
GEOIP_WARNING_AGE_DAYS=7
GEOIP_MAX_AGE_DAYS=30
GEOIP_LOOKUP_TTL_HOURS=24
GEOIP_RETRY_MINUTES=60

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Para um teste SMTP controlado, substitua temporariamente os valores acima:
# MAIL_MAILER=smtp
# MAIL_SCHEME=tls
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=<SMTP_LOGIN>
# MAIL_PASSWORD=<SMTP_KEY>
# MAIL_FROM_ADDRESS=<VERIFIED_SENDER>
# MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
